{
  "name": "mc-scaffolding",
  "version": "0.1.0",
  "description": "CLI for scaffolding Minecraft Bedrock Script API addons.",
  "author": "tapu18",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapu18/mc-scaffolding.git"
  },
  "type": "module",
  "bin": {
    "mc-scaffolding": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node scripts/clean-dist.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.7",
    "chokidar": "^4.0.3",
    "commander": "^14.0.2",
    "esbuild": "^0.25.12",
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
